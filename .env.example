# Copy to .env and fill in.  .env is gitignored — never commit real values.

# --- Bright Data ---------------------------------------------------------
# The CLI stores credentials after `brightdata login`, so the backend does not
# need this at runtime. It is here for CI and non-interactive environments.
# Precedence inside the CLI: flags -> env -> ~/.brightdata/config.json
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=cli_unlocker
BDATA_BINARY=brightdata

# --- Admin auth ----------------------------------------------------------
# Gates POST /run, /heal, /approve. Generate with:
#   py -3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start if this is empty — an unset secret must never mean "open".
ADMIN_API_KEY=

# --- Copilot (AI assistant) ---------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COPILOT_PROVIDER=groq
COPILOT_MODEL=llama-3.3-70b-versatile

# --- Storage -------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./signals.db
RAW_PAYLOAD_DIR=data/raw

# --- HTTP ----------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Self-healing demo ---------------------------------------------------
# Bright Data runs collectors on its own infrastructure, so fixture URLs must be
# publicly reachable. localhost will return nothing. Host fixtures/ on GitHub Pages.
FIXTURE_BASE_URL=https://YOUR-GITHUB-USER.github.io/signal-atlas/fixtures
